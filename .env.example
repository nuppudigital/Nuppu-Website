# Copy this file to .env and fill in real values for local development.
# On Vercel, set these as Project → Settings → Environment Variables instead.

# --- Server ---
PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Database ---
# Leave MONGODB_REQUIRED unset/false to run the API without a database
# (contact form / payments routes that need it will simply no-op or error).
MONGODB_URI=mongodb://localhost:27017/nuppu
MONGODB_REQUIRED=false

# --- Admin / cron auth ---
# Long static bearer token, still accepted on admin-only routes as a fallback
# (scripts, curl, emergency access) alongside the OTP sign-in flow below.
ADMIN_TOKEN=
# Bearer token Vercel Cron sends automatically when set as a project env var.
CRON_SECRET=
# Comma-separated list of emails allowed to request an admin sign-in code via
# POST /api/admin/otp/request. Defaults to the current admin team if unset -
# see api/index.js's ADMIN_OTP_EMAILS constant.
ADMIN_OTP_EMAILS=laura@nuppuapp.fi,emmi@nuppuapp.fi,nuppudigital@gmail.com

# --- Email (contact form notifications) ---
NUPPU_EMAIL=hello@nuppu.app
# Optional - also notified (alongside NUPPU_EMAIL) specifically when a paid
# consultation booking comes in, not on general contact form submissions.
# Comma-separated for multiple recipients, e.g. a@example.com,b@example.com
BOOKING_NOTIFY_EMAIL=
MAIL_FROM=noreply@nuppu.app
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- SMS receipts (Twilio) ---
# Use a plain Twilio phone number, not a branded alphanumeric sender name -
# Finland (Traficom) requires those to be pre-registered as of May 2026.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Paytrail payments ---
# Leave unset to fall back to Paytrail's published TEST merchant credentials.
PAYTRAIL_MERCHANT_ID=
PAYTRAIL_SECRET_KEY=
PAYTRAIL_API_BASE_URL=

# --- Frontend (Vite) ---
# Required in production builds; defaults to http://localhost:5050/api in dev.
VITE_API_BASE_URL=http://localhost:5050/api

# Used for the Open Graph/Twitter card URLs baked into index.html at build time.
# Set this to your real domain (e.g. https://nuppu.fi) before deploying.
VITE_SITE_URL=http://localhost:5173
