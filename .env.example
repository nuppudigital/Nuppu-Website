# Template for .env — copy this file to .env and fill in real values for local dev.
# Production values live in Vercel → Project → Settings → Environment Variables.

# --- Server ---
PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/nuppu
MONGODB_REQUIRED=false               # true requires Mongo; false lets the API run without it (payments/contact routes just no-op)

# --- Admin / cron auth ---
ADMIN_TOKEN=                                                              # bearer token for admin-only routes
CRON_SECRET=                                                              # bearer token Vercel Cron sends automatically
ADMIN_OTP_EMAILS=laura@nuppuapp.fi,emmi@nuppuapp.fi,nuppudigital@gmail.com # who can request an admin sign-in code
ADMIN_DASHBOARD_URL=                                                      # admin-dashboard's standalone origin, e.g. https://admin.nuppuapp.fi - set once it's deployed there; blank locally is fine (5174 is covered separately)

# --- Email (contact form + booking notifications) ---
NUPPU_EMAIL=hello@nuppu.app
BOOKING_NOTIFY_EMAIL=   # also notified on paid bookings; comma-separated
MAIL_FROM=noreply@nuppu.app
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- SMS receipts (Twilio) ---
# Use a plain phone number, not a branded sender name (required in Finland since May 2026)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Paytrail payments ---
PAYTRAIL_MERCHANT_ID=       # blank = fall back to Paytrail's public TEST credentials
PAYTRAIL_SECRET_KEY=
PAYTRAIL_API_BASE_URL=

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:5050/api
VITE_SITE_URL=http://localhost:5173   # used for Open Graph/Twitter card URLs; set to the real domain before deploying
